APP_ENV=development
APP_DEBUG=false
APP_BASE_PATH=
PORT=8080

# DATABASE_URL takes priority when it is set.
DATABASE_URL=
DB_HOST=db
DB_PORT=5432
DB_NAME=travel_guide
DB_USER=travel_guide
DB_PASSWORD=change-this-local-password
DB_SSLMODE=disable

# Used only by: php scripts/seed_admin.php
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Required in production because Render's filesystem is ephemeral.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=travel-guide-uploads
SUPABASE_SERVICE_ROLE_KEY=

UPLOAD_MAX_BYTES=2097152
MAX_POST_IMAGES=5
REMEMBER_DAYS=30
